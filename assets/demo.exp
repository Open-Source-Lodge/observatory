# Drive observatory for the demo GIF. The script assets/demo.sh starts this file.
set timeout 20
set stty_init "rows 14 columns 128"
set send_slow {1 0.08}

# Wait and read the output of observatory at the same time.
proc pause {s} { expect -timeout $s timeout }

log_user 0
spawn observatory
log_user 1
# Answer the terminal queries of bubbletea, or it waits 5 seconds.
expect -re {\[6n} { send "\033\]11;rgb:1e1e/1e1e/2e2e\033\\\033\[1;1R" }
expect "OBS-002"
pause 2
send "n"
pause 1
send -s "No print statements"
pause 1
send "\007"
expect "filled by"
pause 3
send "\r"
expect "OBS-003"
pause 2
send "R"
expect "Checked"
pause 5
send "\033"
pause 2
send "q"
expect eof
